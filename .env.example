# Copiar a .env.local SOLO cuando exista un proyecto Supabase de desarrollo.
# No colocar claves secretas/service_role ni contraseñas aquí.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Alternativa para proyectos con clave pública antigua:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Origen permitido para recuperación; HTTPS salvo localhost en desarrollo.
NEXT_PUBLIC_APP_URL=
